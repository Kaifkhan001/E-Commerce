# Copy this file to .env.local for local development and fill in real
# values. Never commit .env.local (it's in .gitignore already).

# --- Mode switch --------------------------------------------------------
# false = mock data mode (no Shopify credentials needed, runs out of the box)
# true  = live Shopify mode (requires the SHOPIFY_* vars below)
SHOPIFY_ENABLED=false

# --- Shopify Storefront API ---------------------------------------------
# From Shopify Admin: Settings > Apps and sales channels > Develop apps >
# [your app] > API credentials. Use a Storefront API access token (public,
# read-focused) — NOT an Admin API token.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Only needed if you add authenticated/private Storefront API calls later.
SHOPIFY_PRIVATE_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-04

# --- Shopify Admin API (order tracking only) -----------------------------
# Used exclusively by lib/shopify/admin-client.ts to look up order status
# for the /track-order page. NOT a static Admin API token — these are a
# custom app's Client Credentials (Settings > Apps and sales channels >
# Develop apps > [your app] > API credentials > Client credentials), which
# get exchanged automatically for a short-lived access token (refreshed
# before it expires). This grant only works on development stores; other
# stores need the Authorization Code Grant flow instead. Leave blank to
# disable order tracking.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# --- NextAuth -------------------------------------------------------------
# Generate with: npx auth secret
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (optional — omit to hide the Google login button) ------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook OAuth (optional — omit to hide the Facebook login button) --
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Email (magic link) sign-in (optional) --------------------------------
# Requires ALL five of these AND a database (AUTH_DATABASE_URL) — NextAuth
# stores email verification tokens in a database, it cannot run this flow
# as pure JWT. See README "Email provider setup".
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
AUTH_DATABASE_URL=

# --- Razorpay --------------------------------------------------------------
# NOTE: with this app's architecture (Shopify-hosted checkout), Razorpay is
# configured entirely in Shopify Admin (Settings > Payments > Add provider >
# "All-in-one Razorpay Payment Gateway") — no code integration needed, and
# these keys are not currently read anywhere in this codebase. They're
# listed here only in case you later build custom payment flows outside
# Shopify's checkout. See README "Razorpay configuration" before using them.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Delivery partner (pincode serviceability check on product pages) ---
# This only powers the "Check delivery to your pincode" widget on product
# pages. Actual order fulfillment (AWB generation, pickup scheduling,
# tracking, COD remittance) happens via a Shopify Admin app — see README
# "Delivery partner setup" — not through these credentials.
# SHIPPING_PROVIDER: "shiprocket" (implemented) or leave blank to hide the checker.
SHIPPING_PROVIDER=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# The pincode your warehouse ships from — required for accurate estimates.
SHIPROCKET_PICKUP_PINCODE=

# --- Site ------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Aramis Bags

# --- Analytics (optional — features that use these no-op when unset) -----
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
